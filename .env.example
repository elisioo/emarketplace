# Get these values from Supabase Project Settings / Connect.
# Only use a public publishable or anon key; never a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server-only email configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=your-resend-api-key
# Use an address on your verified Resend domain for real seller notifications.
# This test sender can only notify your Resend account's own email address.
RESEND_FROM_EMAIL=Emarketplace <onboarding@resend.dev>
# Stripe Connect sandbox payments (server secrets must never use NEXT_PUBLIC_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-test-publishable-key
STRIPE_SECRET_KEY=your-stripe-test-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
# Local: http://localhost:3000. Vercel Production: https://emarketplace-eli.vercel.app
APP_URL=http://localhost:3000

# AI assistant (server-only). GROQ_API is also accepted for an existing configuration.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
