# Get these values from Supabase Project Settings / Connect.
# Only use a public publishable or anon key; never a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server-only email configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=your-resend-api-key
# Use an address on your verified Resend domain for real seller notifications.
# This test sender can only notify your Resend account's own email address.
RESEND_FROM_EMAIL=Emarketplace <onboarding@resend.dev>
